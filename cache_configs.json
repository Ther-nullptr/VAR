      "enable_mlp_cache": true,
      "threshold": 0.6,
      "adaptive_threshold": false
    },
    
    "attention_focused": {
      "description": "Cache only attention layers for memory efficiency",
      "skip_stages": [169, 256],
      "cache_stages": [100, 169],
      "enable_attn_cache": true,
      "enable_mlp_cache": false,
      "threshold": 0.7,
      "adaptive_threshold": false
    },
    
    "mlp_focused": {
      "description": "Cache only MLP layers for compute efficiency",
      "skip_stages": [169, 256],
      "cache_stages": [100, 169],
      "enable_attn_cache": false,
      "enable_mlp_cache": true,
      "threshold": 0.7,
      "adaptive_threshold": false
    },
    
    "adaptive_smart": {
      "description": "Adaptive caching with intelligent threshold adjustment",
      "skip_stages": [100, 169, 256],
      "cache_stages": [64, 100, 169],
      "enable_attn_cache": true,
      "enable_mlp_cache": true,
      "threshold": 0.7,
      "adaptive_threshold": true,
      "interpolation_mode": "bilinear"
    },
    
    "high_quality": {
      "description": "Conservative caching prioritizing output quality",
      "skip_stages": [256],
      "cache_stages": [169],
      "enable_attn_cache": true,
      "enable_mlp_cache": true,
      "threshold": 0.9,
      "adaptive_threshold": false,
      "interpolation_mode": "bicubic"
    },
    
    "memory_efficient": {
      "description": "Reduce memory usage with selective caching",
      "skip_stages": [169, 256],
      "cache_stages": [169],
      "enable_attn_cache": true,
      "enable_mlp_cache": false,
      "threshold": 0.75,
      "adaptive_threshold": false
    },
    
    "ultra_fast": {
      "description": "Maximum speed with extensive caching",
      "skip_stages": [36, 64, 100, 169, 256],
      "cache_stages": [25, 36, 64, 100, 169],
      "enable_attn_cache": true,
      "enable_mlp_cache": true,
      "threshold": 0.5,
      "adaptive_threshold": true,
      "max_skip_stages": 9
    }
  },
  
