      "threshold": 0.8,
      "adaptive_threshold": false
    },
    
    "aggressive": {
      "description": "Aggressive caching with maximum speedup",
      "skip_stages": [64, 100, 169, 256],
      "cache_stages": [36, 64, 100, 169],
