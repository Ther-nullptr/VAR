      "enable_mlp_cache": false,
      "threshold": 0.7,
      "adaptive_threshold": false
    },
    
    "original_var": {
      "description": "Original VAR caching strategy from the paper",
      "skip_stages": [169, 256],
      "cache_stages": [100, 169],
      "enable_attn_cache": true,
      "enable_mlp_cache": true,
      "threshold": 0.7,
      "adaptive_threshold": false
    },
    
    "conservative": {
      "description": "Conservative caching with minimal skipping",
